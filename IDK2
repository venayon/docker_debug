import org.openqa.selenium.ElementClickInterceptedException;
import org.openqa.selenium.ElementNotInteractableException;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.NoSuchElementException;
import org.openqa.selenium.StaleElementReferenceException;
import org.openqa.selenium.TimeoutException;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.WebDriverWait;

import java.time.Duration;
import java.util.Locale;
import java.util.Objects;
import java.util.Optional;
import java.util.function.Function;

/**
 * Stateless Selenium wait helpers suitable for use from Spring-managed and
 * Cucumber parallel test contexts.
 *
 * <p>Public signatures are intentionally stable. Invalid arguments fail fast;
 * expected browser timing and element-state failures are represented by the
 * documented return value.</p>
 */
public final class WaitUtil {

    private static final System.Logger LOG = System.getLogger(WaitUtil.class.getName());
    private static final Duration WAIT_TIME = Duration.ofSeconds(30);
    private static final Duration POLL_INTERVAL = Duration.ofMillis(250);

    private WaitUtil() {
        throw new AssertionError("No WaitUtil instances");
    }

    public static boolean safeClick(final WebDriver driver, final WebElement element) {
        requireDriverAndElement(driver, element);
        try {
            return Boolean.TRUE.equals(waitFor(driver).until(ignored -> attemptNativeClick(element)));
        } catch (TimeoutException exception) {
            logFailure("safeClick timed out", element, exception);
            return false;
        } catch (RuntimeException exception) {
            logFailure("safeClick failed", element, exception);
            return false;
        }
    }

    public static boolean waitAndClick(final WebDriver driver, final WebElement element) {
        requireDriverAndElement(driver, element);
        final long startedAt = System.nanoTime();
        try {
            waitFor(driver).until(ignored -> isGenuinelyReady(element));
            try {
                element.click();
                return true;
            } catch (StaleElementReferenceException exception) {
                logFailure("Element became stale; retrying native click", element, exception);
                return safeClick(driver, element);
            } catch (ElementClickInterceptedException | ElementNotInteractableException exception) {
                logFailure("Native click blocked; trying JavaScript click", element, exception);
                return jsClick(driver, element);
            }
        } catch (TimeoutException exception) {
            logFailure("waitAndClick timed out", element, exception);
            return false;
        } catch (RuntimeException exception) {
            logFailure("waitAndClick failed", element, exception);
            return false;
        } finally {
            if (LOG.isLoggable(System.Logger.Level.DEBUG)) {
                LOG.log(System.Logger.Level.DEBUG, "waitAndClick completed in {0} ms",
                        Duration.ofNanos(System.nanoTime() - startedAt).toMillis());
            }
        }
    }

    public static Optional<String> waitForVisibleText(final WebDriver driver, final WebElement element) {
        requireDriverAndElement(driver, element);
        try {
            return Optional.of(waitFor(driver).until(ignored -> nonBlankVisibleText(element)));
        } catch (TimeoutException exception) {
            logFailure("waitForVisibleText timed out", element, exception);
            return Optional.empty();
        } catch (RuntimeException exception) {
            logFailure("waitForVisibleText failed", element, exception);
            return Optional.empty();
        }
    }

    public static boolean waitForTextToContain(final WebDriver driver, final WebElement element,
                                               final String expectedText) {
        requireDriverAndElement(driver, element);
        final String needle = requireNonBlank(expectedText, "expectedText").toLowerCase(Locale.ROOT);
        try {
            return Boolean.TRUE.equals(waitFor(driver).until(ignored -> {
                final String actual = nonBlankVisibleText(element);
                return actual != null && actual.toLowerCase(Locale.ROOT).contains(needle);
            }));
        } catch (TimeoutException exception) {
            logFailure("waitForTextToContain timed out", element, exception);
            return false;
        } catch (RuntimeException exception) {
            logFailure("waitForTextToContain failed", element, exception);
            return false;
        }
    }

    public static boolean waitForCondition(final WebDriver driver, final String description,
                                           final Function<WebDriver, Boolean> condition) {
        Objects.requireNonNull(driver, "driver must not be null");
        final String context = requireNonBlank(description, "description");
        Objects.requireNonNull(condition, "condition must not be null");
        try {
            return Boolean.TRUE.equals(waitFor(driver).until(condition));
        } catch (TimeoutException exception) {
            logFailure("Timed out waiting for " + context, null, exception);
            return false;
        } catch (RuntimeException exception) {
            logFailure("Failed while waiting for " + context, null, exception);
            return false;
        }
    }

    public static boolean waitForTitleToContain(final WebDriver driver, final String expectedTitle) {
        final String expected = requireNonBlank(expectedTitle, "expectedTitle");
        final String needle = expected.toLowerCase(Locale.ROOT);
        return waitForCondition(driver, "title contains '" + expected + "'", currentDriver -> {
            final String title = currentDriver.getTitle();
            return title != null && title.toLowerCase(Locale.ROOT).contains(needle);
        });
    }

    public static boolean waitForUrlToContain(final WebDriver driver, final String expectedFragment) {
        final String expected = requireNonBlank(expectedFragment, "expectedFragment");
        return waitForCondition(driver, "URL contains '" + expected + "'", currentDriver -> {
            final String url = currentDriver.getCurrentUrl();
            return url != null && url.contains(expected);
        });
    }

    public static boolean waitForPageLoadComplete(final WebDriver driver) {
        return waitForCondition(driver, "document.readyState is complete", currentDriver -> {
            if (!(currentDriver instanceof JavascriptExecutor executor)) {
                throw new IllegalStateException("WebDriver does not support JavaScript execution");
            }
            return "complete".equals(executor.executeScript("return document.readyState"));
        });
    }

    private static WebDriverWait waitFor(final WebDriver driver) {
        return new WebDriverWait(driver, WAIT_TIME)
                .pollingEvery(POLL_INTERVAL)
                .ignoring(NoSuchElementException.class)
                .ignoring(StaleElementReferenceException.class);
    }

    private static Boolean attemptNativeClick(final WebElement element) {
        try {
            if (!isGenuinelyReady(element)) {
                return false;
            }
            element.click();
            return true;
        } catch (ElementClickInterceptedException | ElementNotInteractableException exception) {
            return false;
        }
    }

    private static boolean isGenuinelyReady(final WebElement element) {
        if (!element.isDisplayed() || !element.isEnabled()) {
            return false;
        }
        if (!"a".equalsIgnoreCase(element.getTagName())) {
            return true;
        }
        return !"true".equalsIgnoreCase(element.getAttribute("aria-disabled"))
                && !"none".equalsIgnoreCase(element.getCssValue("pointer-events"));
    }

    private static String nonBlankVisibleText(final WebElement element) {
        if (!element.isDisplayed()) {
            return null;
        }
        final String text = element.getText();
        if (text == null) {
            return null;
        }
        final String stripped = text.strip();
        return stripped.isEmpty() ? null : stripped;
    }

    private static boolean jsClick(final WebDriver driver, final WebElement element) {
        if (!(driver instanceof JavascriptExecutor executor)) {
            return false;
        }
        try {
            executor.executeScript("arguments[0].click()", element);
            return true;
        } catch (RuntimeException directFailure) {
            logFailure("Direct JavaScript click failed", element, directFailure);
            return clickWithTemporaryOpacity(executor, element);
        }
    }

    private static boolean clickWithTemporaryOpacity(final JavascriptExecutor executor,
                                                     final WebElement element) {
        Object originalInlineOpacity = null;
        boolean opacityRead = false;
        try {
            originalInlineOpacity = executor.executeScript("return arguments[0].style.opacity", element);
            opacityRead = true;
            executor.executeScript("arguments[0].style.opacity='1'; arguments[0].click()", element);
            return true;
        } catch (RuntimeException exception) {
            logFailure("Opacity-assisted JavaScript click failed", element, exception);
            return false;
        } finally {
            if (opacityRead) {
                restoreInlineOpacity(executor, element, originalInlineOpacity);
            }
        }
    }

    private static void restoreInlineOpacity(final JavascriptExecutor executor, final WebElement element,
                                             final Object originalInlineOpacity) {
        try {
            executor.executeScript(
                    "if (arguments[1] === '') { arguments[0].style.removeProperty('opacity'); }"
                            + " else { arguments[0].style.opacity = arguments[1]; }",
                    element, originalInlineOpacity == null ? "" : originalInlineOpacity.toString());
        } catch (RuntimeException exception) {
            logFailure("Could not restore inline opacity", element, exception);
        }
    }

    private static void requireDriverAndElement(final WebDriver driver, final WebElement element) {
        Objects.requireNonNull(driver, "driver must not be null");
        Objects.requireNonNull(element, "element must not be null");
    }

    private static String requireNonBlank(final String value, final String name) {
        Objects.requireNonNull(value, name + " must not be null");
        if (value.isBlank()) {
            throw new IllegalArgumentException(name + " must not be blank");
        }
        return value;
    }

    /** Logging intentionally avoids extra WebDriver calls on the failure path. */
    private static void logFailure(final String message, final WebElement element,
                                   final RuntimeException exception) {
        if (!LOG.isLoggable(System.Logger.Level.WARNING)) {
            return;
        }
        final String elementDescription = element == null ? "n/a" : element.toString();
        LOG.log(System.Logger.Level.WARNING,
                message + "; element=" + elementDescription + "; cause="
                        + exception.getClass().getSimpleName() + ": " + exception.getMessage(), exception);
    }
}
